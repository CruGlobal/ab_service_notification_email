{
   "name": "notification_email",
   "type": "module",
   "version": "1.2.0",
   "description": "A service for sending smtp emails.",
   "main": "app.js",
   "author": "Johnny Hausman",
   "license": "MIT",
   "dependencies": {
      "@digiserve/ab-utils": "github:CruGlobal/ab-utils#1.11.0",
      "cote": "^1.2.0",
      "nodemailer": "^9.0.5",
      "semver": "^7.8.5"
   },
   "scripts": {
      "dev": "node_modules/.bin/nodemon app.js",
      "devBuild": "run-script-os",
      "devInstall": "run-script-os",
      "devBuild:win32": "docker run -it --mount type=bind,source=%cd%,target=/app -w /app node npm install",
      "devInstall:win32": "docker run -it --mount type=bind,source=%cd%,target=/app -w /app node bash",
      "devBuild:darwin:linux": "docker run -it --mount type=bind,source=\"$(pwd)\",target=/app -w /app node npm install",
      "devInstall:darwin:linux": "docker run -it --mount type=bind,source=\"$(pwd)\",target=/app -w /app node bash",
      "lint": "eslint . --fix --max-warnings=0 --report-unused-disable-directives && echo '✔  Your .js files look good.'"
   },
   "devDependencies": {
      "@eslint/js": "^9.15.0",
      "eslint": "^9.26.0",
      "eslint-config-prettier": "^10.1.8",
      "eslint-plugin-prettier": "^5.4.0",
      "globals": "^16.0.0",
      "nodemon": "^3.1.11",
      "prettier": "^3.0.0",
      "run-script-os": "^1.1.5"
   },
   "overrides": {
      "@opentelemetry/api": "^1.7.0",
      "glob": "^13.0.0",
      "acorn-import-assertions": "npm:acorn-import-attributes@^1.9.5",
      "bfj": "9.1.3",
      "minimatch": "10.2.3",
      "serialize-javascript": "^7.0.3",
      "form-data": "4.0.6",
      "follow-redirects": "1.16.0",
      "brace-expansion": "5.0.9",
      "fast-uri": "3.1.6",
      "joi": "17.13.6",
      "qs": "6.15.3",
      "body-parser": "2.3.0",
      "engine.io": "6.6.9",
      "socket.io-parser": "4.2.7",
      "socket.io-adapter": "2.5.8",
      "ws": "8.21.3",
      "js-yaml": "4.3.2",
      "shell-quote": "1.10.0"
   }
}
